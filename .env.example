# Configurações de Ambiente - Frontend Angular
# Copie este arquivo para .env.local e configure com seus valores

# API
ANGULAR_APP_API_URL=http://localhost:3000

# Ambiente
ANGULAR_APP_ENVIRONMENT=development

# Logging
ANGULAR_APP_LOG_LEVEL=debug

# Feature flags
ANGULAR_APP_ENABLE_ANALYTICS=false
ANGULAR_APP_ENABLE_ERROR_REPORTING=false
